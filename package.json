{
  "name": "amni",
  "version": "0.1.0",
  "private": true,
  "packageManager": "pnpm@9.15.0",
  "prettier": "@amni/config/prettier",
  "scripts": {
    "dev": "turbo run dev --parallel",
    "build": "turbo run build",
    "lint": "turbo run lint",
    "typecheck": "turbo run typecheck",
    "test": "turbo run test",
    "test:isolation": "pnpm --filter api test:isolation",
    "test:e2e": "turbo run test:e2e",
    "db:migrate": "pnpm --filter db run migrate",
    "db:seed": "pnpm --filter db run seed",
    "studio": "pnpm --filter db run studio",
    "storybook": "pnpm --filter ui run storybook",
    "audit": "pnpm audit"
  },
  "devDependencies": {
    "turbo": "^2.3.0",
    "typescript": "^5.6.0",
    "prettier": "^3.3.0"
  },
  "engines": {
    "node": ">=20",
    "pnpm": ">=9"
  }
}
