generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ---------------------------------------------------------------------------
// Platform database. Answers "who owns this ERP and how do we manage it".
// It NEVER stores tenant business data (customers, items, invoices, stock) —
// that lives inside each tenant's ERPNext site.
// ---------------------------------------------------------------------------

model User {
  id               String     @id @default(uuid()) @db.Uuid
  email            String     @unique @db.VarChar(254)
  passwordHash     String     @db.VarChar(255)
  firstName        String     @db.VarChar(80)
  lastName         String?    @db.VarChar(80)
  avatarUrl        String?    @db.VarChar(500)
  jobTitle         String?    @db.VarChar(120)
  status           UserStatus @default(ACTIVE)
  isEmailVerified  Boolean    @default(false)
  emailVerifiedAt  DateTime?  @db.Timestamptz(3)
  isPlatformAdmin  Boolean    @default(false)
  failedLoginCount Int        @default(0)
  lockedUntil      DateTime?  @db.Timestamptz(3)
  lastLoginAt      DateTime?  @db.Timestamptz(3)
  locale           Json?
  createdAt        DateTime   @default(now()) @db.Timestamptz(3)
  updatedAt        DateTime   @updatedAt @db.Timestamptz(3)

  memberships        Membership[]
  sessions           Session[]
  emailVerifications EmailVerification[]
  passwordResets     PasswordReset[]
  apiKeys            ApiKey[]
  auditLogs          AuditLog[]
  notifications      Notification[]
  provisionedJobs    ProvisioningJob[]
  invitedBy          Invitation[]        @relation("InvitationCreatedBy")
  importsInitiated   DataImportJob[]
  importsCompletedBy DataImportJob[]     @relation("DataImportCompletedBy")
  onboardingDraft    OnboardingDraft?

  @@map("users")
}

model OnboardingDraft {
  id          String    @id @default(uuid()) @db.Uuid
  userId      String    @unique @db.Uuid
  data        Json
  submittedAt DateTime? @db.Timestamptz(3)
  createdAt   DateTime  @default(now()) @db.Timestamptz(3)
  updatedAt   DateTime  @updatedAt @db.Timestamptz(3)

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("onboarding_drafts")
}

model Session {
  id               String    @id @default(uuid()) @db.Uuid
  userId           String    @db.Uuid
  refreshTokenHash String    @db.VarChar(255)
  userAgent        String?   @db.VarChar(500)
  ip               String?   @db.VarChar(64)
  expiresAt        DateTime  @db.Timestamptz(3)
  lastUsedAt       DateTime  @default(now()) @db.Timestamptz(3)
  revokedAt        DateTime? @db.Timestamptz(3)
  createdAt        DateTime  @default(now()) @db.Timestamptz(3)

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([refreshTokenHash])
  @@map("sessions")
}

model EmailVerification {
  id        String    @id @default(uuid()) @db.Uuid
  userId    String    @db.Uuid
  tokenHash String    @unique @db.VarChar(255)
  expiresAt DateTime  @db.Timestamptz(3)
  usedAt    DateTime? @db.Timestamptz(3)
  createdAt DateTime  @default(now()) @db.Timestamptz(3)

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("email_verifications")
}

model PasswordReset {
  id        String    @id @default(uuid()) @db.Uuid
  userId    String    @db.Uuid
  tokenHash String    @unique @db.VarChar(255)
  expiresAt DateTime  @db.Timestamptz(3)
  usedAt    DateTime? @db.Timestamptz(3)
  createdAt DateTime  @default(now()) @db.Timestamptz(3)

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("password_resets")
}

model ApiKey {
  id         String    @id @default(uuid()) @db.Uuid
  userId     String?   @db.Uuid
  name       String    @db.VarChar(120)
  keyHash    String    @unique @db.VarChar(255)
  scopes     String[]  @default([])
  lastUsedAt DateTime? @db.Timestamptz(3)
  expiresAt  DateTime? @db.Timestamptz(3)
  revokedAt  DateTime? @db.Timestamptz(3)
  createdAt  DateTime  @default(now()) @db.Timestamptz(3)

  user User? @relation(fields: [userId], references: [id], onDelete: SetNull)

  @@index([userId])
  @@map("api_keys")
}

model Company {
  id              String        @id @default(uuid()) @db.Uuid
  name            String        @db.VarChar(120)
  legalName       String?       @db.VarChar(200)
  slug            String        @unique @db.VarChar(120)
  industry        String?       @db.VarChar(80)
  country         String?       @db.VarChar(3)
  taxId           String?       @db.VarChar(40)
  address         String?       @db.VarChar(300)
  email           String?       @db.VarChar(254)
  phone           String?       @db.VarChar(40)
  website         String?       @db.VarChar(200)
  fiscalYearStart String?       @db.VarChar(10)
  status          CompanyStatus @default(ONBOARDING)
  createdAt       DateTime      @default(now()) @db.Timestamptz(3)
  updatedAt       DateTime      @updatedAt @db.Timestamptz(3)

  memberships   Membership[]
  tenant        Tenant?
  subscriptions Subscription[]
  invitations   Invitation[]
  auditLogs     AuditLog[]
  imports       DataImportJob[]

  @@map("companies")
}

model Membership {
  id           String       @id @default(uuid()) @db.Uuid
  companyId    String       @db.Uuid
  userId       String       @db.Uuid
  platformRole PlatformRole @default(MEMBER)
  productRole  ProductRole  @default(MEMBER)
  status       MembershipStatus @default(ACTIVE)
  createdAt    DateTime     @default(now()) @db.Timestamptz(3)

  company Company @relation(fields: [companyId], references: [id], onDelete: Cascade)
  user    User    @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([companyId, userId])
  @@index([companyId, status])
  @@index([userId])
  @@map("memberships")
}

model Tenant {
  id             String       @id @default(uuid()) @db.Uuid
  companyId      String       @unique @db.Uuid
  siteName       String       @unique @db.VarChar(63)
  siteUrl        String       @db.VarChar(255)
  status         TenantStatus @default(CREATING)
  planTier       PlanTier     @default(TRIAL)
  erpnextVersion String       @default("16.30.0") @db.VarChar(32)
  hrmsInstalled  Boolean      @default(false) @map("hrms_installed")
  locale         Json
  region         String       @default("us") @db.VarChar(16)
  createdAt      DateTime     @default(now()) @db.Timestamptz(3)
  updatedAt      DateTime     @updatedAt @db.Timestamptz(3)

  company          Company           @relation(fields: [companyId], references: [id], onDelete: Cascade)
  erpInstance      ERPInstance?
  provisioningJobs ProvisioningJob[]
  dataImports      DataImportJob[]

  @@index([status])
  @@map("tenants")
}

model ERPInstance {
  id                String       @id @default(uuid()) @db.Uuid
  tenantId          String       @unique @db.Uuid
  host              String       @db.VarChar(255)
  cluster           String       @default("default") @db.VarChar(64)
  capacityGroup     String       @default("shared") @db.VarChar(64)
  health            TenantHealth @default(UNKNOWN)
  lastHealthCheckAt DateTime?    @db.Timestamptz(3)
  serviceKeyCipher  String?      @db.Text
  createdAt         DateTime     @default(now()) @db.Timestamptz(3)
  updatedAt         DateTime     @updatedAt @db.Timestamptz(3)

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@index([cluster])
  @@map("erp_instances")
}

model Plan {
  id        String   @id @default(uuid()) @db.Uuid
  code      String   @unique @db.VarChar(40)
  name      String   @db.VarChar(120)
  tier      PlanTier @unique
  price     Decimal  @default(0) @db.Decimal(12, 2)
  limits    Json     @default("{}")
  features  Json     @default("{}")
  isActive  Boolean  @default(true)
  createdAt DateTime @default(now()) @db.Timestamptz(3)
  updatedAt DateTime @updatedAt @db.Timestamptz(3)

  subscriptions Subscription[]

  @@map("plans")
}

model Subscription {
  id          String             @id @default(uuid()) @db.Uuid
  companyId   String             @db.Uuid
  planId      String             @db.Uuid
  status      SubscriptionStatus @default(TRIAL)
  billingPeriod BillingPeriod    @default(MONTHLY)
  startsAt    DateTime           @default(now()) @db.Timestamptz(3)
  trialEndsAt DateTime?          @db.Timestamptz(3)
  endsAt      DateTime?          @db.Timestamptz(3)
  cancelledAt DateTime?          @db.Timestamptz(3)
  createdAt   DateTime           @default(now()) @db.Timestamptz(3)
  updatedAt   DateTime           @updatedAt @db.Timestamptz(3)

  company Company @relation(fields: [companyId], references: [id], onDelete: Cascade)
  plan    Plan    @relation(fields: [planId], references: [id])

  @@index([companyId])
  @@index([status])
  @@map("subscriptions")
}

model ProvisioningJob {
  id             String               @id @default(uuid()) @db.Uuid
  tenantId       String               @db.Uuid
  type           ProvisioningJobType  @default(PROVISION)
  state          ProvisioningJobState @default(CREATED)
  attempts       Int                  @default(0)
  maxAttempts    Int                  @default(5)
  steps          Json                 @default("[]")
  logs           Json                 @default("[]")
  lastError      String?              @db.Text
  runAt          DateTime?            @db.Timestamptz(3)
  startedAt      DateTime?            @db.Timestamptz(3)
  finishedAt     DateTime?            @db.Timestamptz(3)
  createdBy      String?              @db.Uuid
  idempotencyKey String               @unique
  createdAt      DateTime             @default(now()) @db.Timestamptz(3)
  updatedAt      DateTime             @updatedAt @db.Timestamptz(3)

  tenant  Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  creator User?  @relation(fields: [createdBy], references: [id], onDelete: SetNull)

  @@index([tenantId, state])
  @@index([state])
  @@map("provisioning_jobs")
}

model Invitation {
  id           String       @id @default(uuid()) @db.Uuid
  companyId    String       @db.Uuid
  email        String       @db.VarChar(254)
  platformRole PlatformRole @default(MEMBER)
  productRole  ProductRole  @default(MEMBER)
  status       InvitationStatus @default(PENDING)
  firstName    String       @db.VarChar(80)
  lastName     String?      @db.VarChar(80)
  tokenHash    String       @unique @db.VarChar(255)
  expiresAt    DateTime     @db.Timestamptz(3)
  usedAt       DateTime?    @db.Timestamptz(3)
  invitedById  String       @db.Uuid
  createdAt    DateTime     @default(now()) @db.Timestamptz(3)

  company Company @relation(fields: [companyId], references: [id], onDelete: Cascade)
  inviter User    @relation("InvitationCreatedBy", fields: [invitedById], references: [id], onDelete: Cascade)

  @@index([companyId])
  @@index([companyId, status])
  @@index([email])
  @@map("invitations")
}

model AuditLog {
  id           String   @id @default(uuid()) @db.Uuid
  actorId      String?  @db.Uuid
  actorEmail   String?  @db.VarChar(254)
  companyId    String?  @db.Uuid
  action       String   @db.VarChar(120)
  resourceType String   @db.VarChar(120)
  resourceId   String?  @db.VarChar(255)
  metadata     Json?
  ip           String?  @db.VarChar(64)
  requestId    String?  @db.VarChar(64)
  at           DateTime @default(now()) @db.Timestamptz(3)

  actor   User?    @relation(fields: [actorId], references: [id], onDelete: SetNull)
  company Company? @relation(fields: [companyId], references: [id], onDelete: SetNull)

  @@index([companyId, at])
  @@index([actorId])
  @@index([resourceType, resourceId])
  @@map("audit_logs")
}

model DataImportJob {
  id            String      @id @default(uuid()) @db.Uuid
  tenantId      String      @db.Uuid
  companyId     String      @db.Uuid
  kind          String      @db.VarChar(40)
  stage         ImportStage @default(PRE_IMPORT)
  fileMetadata  Json?
  mapping       Json?
  validation    Json?
  summary       Json?
  errorRowsUrl  String?     @db.VarChar(512)
  initiatedById String      @db.Uuid
  completedById String?     @db.Uuid
  createdAt     DateTime    @default(now()) @db.Timestamptz(3)
  updatedAt     DateTime    @updatedAt @db.Timestamptz(3)

  tenant      Tenant  @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  company     Company @relation(fields: [companyId], references: [id], onDelete: Cascade)
  initiatedBy User    @relation(fields: [initiatedById], references: [id], onDelete: Cascade)
  completedBy User?   @relation("DataImportCompletedBy", fields: [completedById], references: [id], onDelete: SetNull)

  @@index([tenantId, stage])
  @@index([companyId, createdAt])
  @@map("data_import_jobs")
}

model Notification {
  id        String    @id @default(uuid()) @db.Uuid
  userId    String    @db.Uuid
  type      String    @db.VarChar(80)
  title     String    @db.VarChar(200)
  body      String?   @db.Text
  link      String?   @db.VarChar(512)
  readAt    DateTime? @db.Timestamptz(3)
  createdAt DateTime  @default(now()) @db.Timestamptz(3)

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, readAt])
  @@map("notifications")
}

// --- Enums ----------------------------------------------------------------

enum UserStatus {
  ACTIVE
  SUSPENDED
  ARCHIVED
}

enum CompanyStatus {
  ONBOARDING
  READY
  ARCHIVED
}

enum PlatformRole {
  OWNER
  ADMIN
  MEMBER
}

enum ProductRole {
  ADMIN
  ACCOUNTANT
  SALES
  INVENTORY
  MEMBER
}

enum MembershipStatus {
  ACTIVE
  DISABLED
}

enum InvitationStatus {
  PENDING
  ACCEPTED
  DISABLED
  EXPIRED
}

enum BillingPeriod {
  MONTHLY
  YEARLY
}

enum TenantStatus {
  CREATING
  PROVISIONING
  CONFIGURING
  VALIDATING
  ACTIVE
  SUSPENDED
  RESUMING
  ARCHIVED
  FAILED
}

enum PlanTier {
  TRIAL
  STARTER
  GROWTH
  SCALE
}

enum TenantHealth {
  UNKNOWN
  HEALTHY
  DEGRADED
  UNREACHABLE
}

enum SubscriptionStatus {
  TRIAL
  ACTIVE
  PAST_DUE
  CANCELLED
  EXPIRED
}

enum ProvisioningJobType {
  PROVISION
  DEACTIVATE
  SUSPEND
  RESUME
  UPDATE_CONFIG
  BACKUP
  RESTORE
}

enum ProvisioningJobState {
  CREATED
  QUEUED
  PROVISIONING
  CONFIGURING
  VALIDATING
  READY
  ACTIVE
  PROVISIONING_FAILED
  CONFIGURATION_FAILED
  VALIDATION_FAILED
  CANCELLED
}

enum ImportStage {
  PRE_IMPORT
  UPLOAD
  MAPPING
  VALIDATION
  IMPORT
  COMPLETED
}
