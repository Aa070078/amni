# Amni API
PORT=4000
NODE_ENV=development
APP_VERSION=dev

# Platform database (Postgres)
DATABASE_URL=postgresql://amni:amni@localhost:5432/amni_platform

# Redis (BullMQ + cache)
REDIS_URL=redis://localhost:6379

# Web origin(s) allowed for CORS (comma-separated)
WEB_ORIGIN=http://localhost:3000

# Platform URL / tenant subdomain base
PLATFORM_URL=http://localhost:3000
PLATFORM_DOMAIN=localhost
