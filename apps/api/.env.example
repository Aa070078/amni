# Amni API
PORT=4000
NODE_ENV=development
APP_VERSION=dev

# Platform database (Postgres)
DATABASE_URL=postgresql://amni:amni@localhost:5432/amni_platform

# Redis (BullMQ + cache)
REDIS_URL=redis://localhost:6379

# Web origin(s) allowed for CORS (comma-separated)
WEB_ORIGIN=http://localhost:3000

# Platform URL / tenant subdomain base
PLATFORM_URL=http://localhost:3000
PLATFORM_DOMAIN=localhost

# Auth (JWT access token signing; MUST be >= 32 chars)
ACCESS_TOKEN_SECRET=change-me-to-a-long-random-string-of-at-least-32-chars
ACCESS_TOKEN_TTL_SECONDS=900
REFRESH_TOKEN_TTL_DAYS=30

# HRMS embed SSO. MUST match the AMNI_SSO_SECRET set on the ERP bench
# (infra/erp/.env) — the amni_bridge app validates the signed token.
HRMS_SSO_SECRET=change-me-to-a-long-random-string-of-at-least-32-chars
HRMS_SSO_TOKEN_TTL_SECONDS=120

# Master key for AES-256-GCM at-rest encryption of per-tenant ERP service
# secrets (packages/erp/src/crypto.ts). MUST be 32 bytes: 64 hex chars or a
# 32-char string. MUST match across API + worker + seed scripts, or decrypting
# a seeded ERPInstance serviceKeyCipher fails at runtime. Local dev may reuse
# the fixture key in apps/e2e/support/constants.ts (E2E_ENCRYPTION_KEY).
ENCRYPTION_KEY=
