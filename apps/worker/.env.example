# Amni worker
NODE_ENV=development
APP_VERSION=dev

# Platform database (Postgres)
DATABASE_URL=postgresql://amni:amni@localhost:5432/amni_platform

# Redis (BullMQ)
REDIS_URL=redis://localhost:6379

# Email (dev: console provider; switch to smtp + SMTP_HOST to send for real)
MAIL_PROVIDER=console
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
MAIL_FROM=Amni <no-reply@amni.local>

# Base URL used for links inside emails
PLATFORM_URL=http://localhost:3000

# ERP cluster access (docker-exec mode in dev)
ERPNEXT_CLUSTER_MODE=docker-exec
ERPNEXT_BENCH_CONTAINER=frappe-backend-1
ERPNEXT_SITES_ROOT=/home/frappe/frappe-bench/sites
