# ERP cluster (frappe_docker) environment — copy to .env and fill.
# Requires the full override set: compose.mariadb.yaml + compose.redis.yaml + compose.noproxy.yaml

ERPNEXT_VERSION=v16.30.0
PULL_POLICY=missing

# Apps installed on every provisioned site (comma-separated). `hrms` is Frappe HR.
ERPNEXT_INSTALL_APPS=erpnext,hrms
# Frappe HR branch matching the ERPNext version pinned above.
HRMS_BRANCH=version-16

# Shared secret between the Amni API (mints HRMS SSO tokens) and the
# amni_bridge app on the bench. MUST be >= 32 chars and identical to
# apps/api/.env HRMS_SSO_SECRET. The bench reads it from
# sites/common_site_config.json ("amni_sso_secret") or the AMNI_SSO_SECRET env.
AMNI_SSO_SECRET=change-me-to-a-long-random-string-of-at-least-32-chars

DB_PASSWORD=admin

# Only if you use external database
DB_HOST=
DB_PORT=

# Only if you use external Redis
REDIS_CACHE=
REDIS_QUEUE=

GUNICORN_THREADS=4
GUNICORN_WORKERS=2
GUNICORN_TIMEOUT=120

LETSENCRYPT_EMAIL=

# Platform ports
HTTP_PUBLISH_PORT=8080
HTTPS_PUBLISH_PORT=

UPSTREAM_REAL_IP_ADDRESS=
UPSTREAM_REAL_IP_RECURSIVE=

PROXY_READ_TIMEOUT=120
CLIENT_MAX_BODY_SIZE=50m
