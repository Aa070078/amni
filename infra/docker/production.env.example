# Copy outside the repository, replace every CHANGE_ME value, then pass with --env-file.
APP_VERSION=0.2.0
AMNI_API_IMAGE=ghcr.io/example/amni-api:0.2.0
AMNI_WORKER_IMAGE=ghcr.io/example/amni-worker:0.2.0
AMNI_WEB_IMAGE=ghcr.io/example/amni-web:0.2.0

PLATFORM_HOST=app.example.com
PLATFORM_DOMAIN=example.com
TLS_EMAIL=ops@example.com

POSTGRES_USER=amni
POSTGRES_PASSWORD=CHANGE_ME_RANDOM_DATABASE_PASSWORD
POSTGRES_DB=amni_platform
REDIS_PASSWORD=CHANGE_ME_RANDOM_REDIS_PASSWORD
ACCESS_TOKEN_SECRET=CHANGE_ME_64_HEX_CHARACTERS
ENCRYPTION_KEY=CHANGE_ME_64_HEX_CHARACTERS
HRMS_SSO_SECRET=CHANGE_ME_64_HEX_CHARACTERS

MAIL_PROVIDER=smtp
MAIL_FROM=Amni <no-reply@example.com>
SMTP_HOST=smtp.example.com
SMTP_PORT=587
SMTP_USER=CHANGE_ME
SMTP_PASS=CHANGE_ME

PROVISIONING_DRIVER=bench
ERPNEXT_CLUSTER_MODE=ssh
ERPNEXT_SSH_HOST=erp-internal.example.com
ERPNEXT_SSH_USER=amni-provisioner
ERPNEXT_SSH_PORT=22
ERP_SSH_KEY_FILE=/run/secrets/amni-erp-provisioner-key
ERP_SSH_KNOWN_HOSTS_FILE=/run/secrets/amni-erp-known-hosts
ERPNEXT_BENCH_CONTAINER=frappe-backend-1
ERPNEXT_INSTALL_APPS=erpnext,hrms,amni_bridge
BENCH_DB_ROOT_PASSWORD=CHANGE_ME
BENCH_ADMIN_PASSWORD=CHANGE_ME

ACCESS_TOKEN_TTL_SECONDS=900
REFRESH_TOKEN_TTL_DAYS=30
HRMS_SSO_TOKEN_TTL_SECONDS=120
LOG_LEVEL=info
