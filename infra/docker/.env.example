# Platform environment — copy to .env and fill. Never commit real values.

# Postgres
DATABASE_URL=postgresql://amni:amni@localhost:5432/amni_platform
POSTGRES_USER=amni
POSTGRES_PASSWORD=amni
POSTGRES_DB=amni_platform

# Redis (BullMQ + cache)
REDIS_URL=redis://localhost:6379

# Auth secrets (generate: openssl rand -hex 32)
JWT_SESSION_SECRET=change-me-32-bytes-hex
REFRESH_TOKEN_SECRET=change-me-32-bytes-hex

# Encryption key for tenant ERP service keys at rest (AES-256-GCM)
ENCRYPTION_KEY=change-me-32-bytes-hex

# Email (dev: console provider)
MAIL_PROVIDER=console
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
MAIL_FROM=Amni <no-reply@amni.local>

# URLs
PLATFORM_URL=http://localhost:3000
PLATFORM_API_URL=http://localhost:4000
PLATFORM_DOMAIN=localhost
CORS_ORIGINS=http://localhost:3000

# ERP cluster access (how the worker reaches the bench)
ERPNEXT_CLUSTER_MODE=docker-exec   # docker-exec | ssh | agent
ERPNEXT_BENCH_CONTAINER=frappe-backend-1
ERPNEXT_SITES_ROOT=/home/frappe/frappe-bench/sites
ERPNEXT_DB_ROOT_PASSWORD=admin

# Observability
SENTRY_DSN=
LOG_LEVEL=info
