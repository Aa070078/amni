# syntax=docker/dockerfile:1

# ---- Base stage: pnpm workspace toolchain ----
FROM node:22-bookworm-slim AS base
RUN corepack enable
WORKDIR /repo

# ---- Dependencies stage ----
FROM base AS deps
COPY package.json pnpm-lock.yaml pnpm-workspace.yaml turbo.json .npmrc ./
COPY packages ./packages
COPY apps/api/package.json apps/api/package.json
COPY apps/worker/package.json apps/worker/package.json
RUN pnpm install --frozen-lockfile

# ---- Build stage ----
FROM deps AS build
COPY packages ./packages
COPY apps/api ./apps/api
COPY apps/worker ./apps/worker
RUN pnpm --filter @amni/db generate
RUN pnpm turbo run build --filter=@amni/api

# ---- Runtime stage ----
FROM node:22-bookworm-slim AS runtime
RUN corepack enable && apt-get update && apt-get install -y --no-install-recommends openssl ca-certificates && rm -rf /var/lib/apt/lists/*
WORKDIR /repo
ENV NODE_ENV=production
ENV PORT=4000

COPY --from=build /repo/node_modules ./node_modules
COPY --from=build /repo/packages ./packages
COPY --from=build /repo/apps/api/dist ./apps/api/dist
COPY --from=build /repo/apps/api/scripts ./apps/api/scripts
COPY --from=build /repo/apps/api/node_modules ./apps/api/node_modules
COPY --from=build /repo/packages/db/prisma ./packages/db/prisma

RUN node_modules/.bin/prisma generate --schema packages/db/prisma/schema.prisma

EXPOSE 4000

CMD ["sh", "-c", "node_modules/.bin/prisma migrate deploy --schema packages/db/prisma/schema.prisma && node_modules/.bin/tsx apps/api/scripts/seed-demo-user.ts && node apps/api/dist/main.js"]
